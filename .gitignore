*.log

# --- Raw downloads (large, regenerable via scripts/01_download_sources.R) ---
data/raw/
data/processed/
data/unmapped/

# --- Generated mapping tables & stats (regenerable via scripts/run_all.R) ---
results/mapping_tables/
results/stats/

